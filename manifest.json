{
  "manifest_version": 3,
  "name": "PDBHL · Pin Downloader by HL",
  "version": "1.2.0",
  "description": "Baixa imagens, GIFs e vídeos do Pinterest na qualidade original com um clique.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.com.br/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.com.au/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PDBHL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
